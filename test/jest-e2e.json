{
	"moduleFileExtensions": ["js", "json", "ts"],
	"rootDir": "..",
	"testEnvironment": "node",
	"testRegex": ".e2e-spec.ts$",
	"transform": {
		"^.+\\.ts$": [
			"@swc/jest",
			{
				"jsc": {
					"parser": {
						"syntax": "typescript",
						"decorators": true
					},
					"transform": {
						"legacyDecorator": true,
						"decoratorMetadata": true
					},
					"target": "es2022"
				},
				"module": {
					"type": "es6"
				}
			}
		]
	},
	"extensionsToTreatAsEsm": [".ts"]
}
