{
	"compilerOptions": {
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"declaration": true,
		"removeComments": true,
		"emitDecoratorMetadata": true,
		"experimentalDecorators": true,
		"target": "es2022",
		"sourceMap": true,
		"outDir": "./dist",
		"esModuleInterop": true,
		"skipLibCheck": true,
		"strict": false,
		"rewriteRelativeImportExtensions": true,
		"types": ["node", "jest"],
		"rootDir": "./"
	},
	"exclude": ["node_modules", "dist"]
}
